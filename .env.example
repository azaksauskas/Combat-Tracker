# Sync backend: "firebase" (default, realtime across devices) or "local"
# (browser localStorage + cross-tab sync; no network, handy for development).
VITE_SYNC_BACKEND=firebase

# Namespace for the shared data inside Firestore. Keep the old default to
# read data saved by the previous single-file version.
VITE_APP_ID=default-dnd-app-id

# Firebase web config. Defaults to the project the original HTML used.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
